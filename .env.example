# Client (exposed to browser — never put secrets here)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_APP_ENV=development
VITE_COMPLIANCE_MIN_AGE=21
VITE_DEFAULT_BANKROLL_USD=1000
VITE_DEFAULT_KELLY_FRACTION=0.25
VITE_SENTRY_DSN=
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Server-only (Supabase secrets — never prefix with VITE_)
# SUPABASE_SERVICE_ROLE_KEY=
# ODDS_API_KEY=
# KALSHI_API_KEY=
# ANTHROPIC_API_KEY=

# Stripe (web subscriptions)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_PRO=
# STRIPE_PRICE_ELITE=
# SITE_URL=http://localhost:5173

# Apple App Store (iOS subscriptions)
# APPLE_ISSUER_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY=
# APPLE_VERIFY_CHAIN=1

# Persona (ID verification)
# PERSONA_API_KEY=
# PERSONA_TEMPLATE_ID=
# PERSONA_WEBHOOK_SECRET=

# MaxMind GeoIP2 Insights (compliance / VPN detection)
# MAXMIND_ACCOUNT_ID=
# MAXMIND_LICENSE_KEY=
# COMPLIANCE_BLOCK_ANONYMIZERS=1

# FingerprintJS Pro (device fingerprinting)
VITE_FINGERPRINT_PUBLIC_KEY=
VITE_FINGERPRINT_REGION=us
# FINGERPRINT_API_KEY=
# FINGERPRINT_REGION=us
# MAX_ACCOUNTS_PER_FINGERPRINT=3
# FINGERPRINT_WINDOW_DAYS=30

# BetterStack (Logtail) — edge function log drain
# BETTERSTACK_SOURCE_TOKEN=
# BETTERSTACK_HOST=https://in.logs.betterstack.com

# Ops alerting
# ALERT_WEBHOOK_URL=

# pg_cron settings (set these via `alter database postgres set ...` instead of env)
#   app.settings.supabase_url
#   app.settings.service_role_key
